@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IMediator Mediator

<PageTitle>Task Manager</PageTitle>

<header class="header">
    <h1 class="logo">&#128203; Task Manager</h1>
    @if (PendingCount > 0)
    {
        <span class="pending-count">@PendingCount pending</span>
    }
    <button class="btn btn-primary" @onclick="OpenAddModal">+ New Task</button>
</header>

<main class="main">
    <div class="filters">
        <button class="filter-btn @ActiveClass("pending")" @onclick="@(() => SetFilter("pending"))">Pending</button>
        <button class="filter-btn @ActiveClass("all")"     @onclick="@(() => SetFilter("all"))">All</button>
        <button class="filter-btn @ActiveClass("done")"    @onclick="@(() => SetFilter("done"))">Done</button>
    </div>

    <div class="task-list">
        @if (!FilteredTasks().Any())
        {
            <p class="empty">No tasks here.</p>
        }
        else
        {
            @foreach (var task in FilteredTasks())
            {
                <div class="task-card priority-@task.Priority.ToString().ToLower() @(task.IsCompleted ? "done" : "")">
                    <div class="task-top">
                        <span class="task-title">@task.Title</span>
                        @if (task.IsCompleted)
                        {
                            <span class="badge badge-done">Done</span>
                        }
                        else
                        {
                            <span class="badge badge-@task.Priority.ToString().ToLower()">@task.Priority</span>
                        }
                    </div>
                    <div class="task-meta">@FormatDueDate(task.DueDate)</div>
                    @if (!string.IsNullOrEmpty(task.Description))
                    {
                        <div class="task-desc">@task.Description</div>
                    }
                    <div class="task-actions">
                        @if (!task.IsCompleted)
                        {
                            <button class="btn btn-sm btn-complete" @onclick="@(async () => await CompleteTask(task.Id))">&#10003; Done</button>
                        }
                        <button class="btn btn-sm btn-edit"   @onclick="@(() => OpenEditModal(task))">Edit</button>
                        <button class="btn btn-sm btn-delete" @onclick="@(async () => await DeleteTask(task.Id))">Delete</button>
                    </div>
                </div>
            }
        }
    </div>
</main>

@if (_showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal" @onclick:stopPropagation>
            <h2>@(_editingId.HasValue ? "Edit Task" : "New Task")</h2>
            <div class="field">
                <label>Title <span class="required">*</span></label>
                <input type="text" @bind="_formTitle" placeholder="What needs to be done?" />
            </div>
            <div class="field">
                <label>Description</label>
                <textarea @bind="_formDescription" placeholder="Optional details..." rows="2"></textarea>
            </div>
            <div class="row">
                <div class="field">
                    <label>Due Date</label>
                    <input type="date" @bind="_formDueDate" />
                </div>
                <div class="field">
                    <label>Priority</label>
                    <select @bind="_formPriority">
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn btn-ghost" @onclick="CloseModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveTask">Save Task</button>
            </div>
        </div>
    </div>
}

@code {
    private List<TaskItem> _allTasks = [];
    private string _currentFilter = "pending";
    private bool _showModal;
    private Guid? _editingId;

    private string _formTitle = "";
    private string _formDescription = "";
    private DateOnly? _formDueDate;
    private string _formPriority = "Medium";

    private int PendingCount => _allTasks.Count(t => !t.IsCompleted);

    protected override async Task OnInitializedAsync() => await LoadTasks();

    private async Task LoadTasks()
        => _allTasks = (await Mediator.Send(new GetAllTasksQuery())).ToList();

    private List<TaskItem> FilteredTasks()
    {
        var filtered = _currentFilter switch
        {
            "all"  => _allTasks,
            "done" => _allTasks.Where(t => t.IsCompleted).ToList(),
            _      => _allTasks.Where(t => !t.IsCompleted).ToList()
        };

        var order = new Dictionary<Priority, int>
        {
            [Priority.High]   = 0,
            [Priority.Medium] = 1,
            [Priority.Low]    = 2
        };

        return filtered
            .OrderBy(t => order[t.Priority])
            .ThenBy(t => t.DueDate.GetValueOrDefault(DateTime.MaxValue))
            .ToList();
    }

    private string ActiveClass(string filter) => _currentFilter == filter ? "active" : "";

    private void SetFilter(string filter) => _currentFilter = filter;

    private static string FormatDueDate(DateTime? d) =>
        d.HasValue ? d.Value.ToString("d MMM yyyy") : "No due date";

    private void OpenAddModal()
    {
        _editingId = null;
        _formTitle = "";
        _formDescription = "";
        _formDueDate = null;
        _formPriority = "Medium";
        _showModal = true;
    }

    private void OpenEditModal(TaskItem task)
    {
        _editingId = task.Id;
        _formTitle = task.Title;
        _formDescription = task.Description;
        _formDueDate = task.DueDate.HasValue ? DateOnly.FromDateTime(task.DueDate.Value) : null;
        _formPriority = task.Priority.ToString();
        _showModal = true;
    }

    private void CloseModal() => _showModal = false;

    private async Task SaveTask()
    {
        if (string.IsNullOrWhiteSpace(_formTitle)) return;

        var priority = Enum.Parse<Priority>(_formPriority);
        var dueDate = _formDueDate?.ToDateTime(TimeOnly.MinValue);

        if (_editingId.HasValue)
            await Mediator.Send(new EditTaskCommand(_editingId.Value, _formTitle, _formDescription, dueDate, priority));
        else
            await Mediator.Send(new AddTaskCommand(_formTitle, _formDescription, dueDate, priority));

        CloseModal();
        await LoadTasks();
    }

    private async Task CompleteTask(Guid id)
    {
        await Mediator.Send(new CompleteTaskCommand(id));
        await LoadTasks();
    }

    private async Task DeleteTask(Guid id)
    {
        await Mediator.Send(new DeleteTaskCommand(id));
        await LoadTasks();
    }
}
